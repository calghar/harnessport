{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "postgres": {
      "type": "local",
      "command": ["npx", "mcp-postgres"],
      "environment": { "PG_URL": "{env:PG_URL}" },
      "enabled": true
    }
  },
  "permission": {
    "bash": { "git push *": "ask", "npm run *": "allow" },
    "webfetch": "allow"
  },
  "formatter": {
    "biome": { "command": ["biome", "format", "--write", "$FILE"], "extensions": [".ts"] }
  }
}
